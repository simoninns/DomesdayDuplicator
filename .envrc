# direnv configuration. Entering the repository activates the default development shell,
# so the toolchain is on PATH without having to remember `nix develop`.
#
# Install direnv, then run `direnv allow` once in this directory. Everyone else is
# unaffected — this file does nothing until you opt in.
#
# This file sits at the repository root, next to the one and only flake.nix, and covers the
# whole tree — there is no per-component .envrc because there is no per-component flake.
#
# For a component shell instead of the default one, override it in .envrc.local:
#   use flake .#ddd-gui

use flake

# Machine-local overrides, not tracked by git
if [ -f .envrc.local ]; then
  source_env .envrc.local
fi
