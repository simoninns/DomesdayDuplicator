# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# =========================
# Operating System Files
# =========================

# OSX
# =========================

.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# CMake related things
*.depends
*.ninja
*_autogen/
.ninja_*
.qt/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
moc_*.cpp
moc_*.cpp_parameters
ui_*.h

# Build trees
build/
build-*/

# Nix build outputs. `nix build` symlinks its result into the working directory by default,
# and the workflows use --out-link names of their own.
result
result-*

# MkDocs output. mkdocs.yml lives in docs/, so a bare `mkdocs build` writes docs/site/ —
# site_dir defaults to "site" relative to the config file, which is also why the content
# directory is called content/ and not site/.
site/

# Packaging outputs and scratch (gui/packaging, .github/workflows/package-*.yml).
# *.msi is already covered by the Windows section above.
dist/
stage/
repo/
.flatpak-builder/
*.flatpak
*.dmg
*.iconset/
files.wxs
wix-license.rtf
*.wixobj
*.wixpdb

# Capture files. Nothing in the repository should ever contain one: an hour of LaserDisc RF
# is around 90 GB, and finding that out after `git add -A` is not the moment to learn it.
*.ldf
*.lds
*.raw

# Python bytecode. The only Python in the tree is the FPGA provenance tool and
# its test, both of which import each other by path — which is enough to leave
# a __pycache__ behind next to the sources.
__pycache__/
*.py[cod]

# =========================
# Editor and IDE files
# =========================
# Kept at the root so no component tree can quietly reintroduce an editor dependency.

# Language-server output. compile_commands.json is generated by
# CMAKE_EXPORT_COMPILE_COMMANDS and symlinked to each component root; it must never be
# committed, because it embeds absolute paths from whoever configured the build.
compile_commands.json
.cache/
.clangd/

# Visual Studio Code
.vscode/

# JetBrains
.idea/

# Qt Creator
*.user
*.user.*
*.autosave
*.creator.user*
*.pro.user*
.qmake.cache
.qmake.stash

# Eclipse (the FX3 sources were originally an Eclipse CDT project)
.project
.cproject
.settings/
*.launch
.metadata

# Vim / Emacs
*~
*.swp
.*.swp
\#*\#
.\#*

# direnv
.direnv/

# direnv machine-local overrides
.envrc.local
