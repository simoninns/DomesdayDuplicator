# Static analysis for the capture application.
#
# Domesday Duplicator - LaserDisc RF sampler
# SPDX-FileCopyrightText: 2026 Simon Inns
# SPDX-License-Identifier: GPL-3.0-or-later
#
# cert-flp30-c is named on purpose, and it is the one entry here that is not just a
# family. It is the float-loop-counter rule, which newer clang-tidy releases also carry
# as bugprone-float-loop-counter — so which of the two names exists depends on the
# version doing the analysis, and a config naming only the family catches it on some
# machines and not others. That is not hypothetical: this project ran eight commits with
# a CI failure no developer's clang-tidy could reproduce, because the runners had the
# name that fires and the development shell had the name that does not. Both are listed,
# an unknown check name is ignored rather than an error, so this holds whichever way the
# toolchain moves.
Checks: '-*,google-*,bugprone-*,cert-flp30-c,-bugprone-easily-swappable-parameters,-bugprone-exception-escape,modernize-use-override'
WarningsAsErrors: '*'
HeaderFilterRegex: 'ddd-gui/(src|tests)/'
