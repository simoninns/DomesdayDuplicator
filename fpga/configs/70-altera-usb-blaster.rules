# Device permissions for the Altera USB-Blaster, the JTAG cable that programs the FPGA.
#
# The DE0-NANO carries an on-board USB-Blaster, so on that board this is the only cable
# involved: it enumerates as 09fb:6001 on the same USB connector used to power the board.
#
# nixpkgs' quartus-prime-lite ships no udev rules at all (checked), so without this file the
# device node is root-only and both of the tools that touch JTAG fail the same way:
#
#     $ jtagconfig
#     1) USB-Blaster variant [7-3.2]
#       Unable to lock chain - Insufficient port permissions
#
# TAG+="uaccess" grants access to the user at the active seat on any systemd-logind system,
# including NixOS. MODE is kept at 0666 to match the FX3 rule beside it and to cover systems
# without logind; tighten it to 0660 if uaccess covers all of your users.
#
# THE FILENAME IS LOAD-BEARING. udev processes rule files in lexical order, and systemd
# consumes the uaccess tag in 73-seat-late.rules:
#
#     TAG=="uaccess", ENV{MAJOR}!="", RUN{builtin}+="uaccess"
#
# A rule that sets the tag in a file sorting after 73 sets it too late: 73 has already run,
# nothing consumes it, and no ACL is applied — while MODE, which udev accumulates across all
# matching rules and applies at node creation, keeps working. That combination is why the
# same bug survived for years in this project's FX3 rule as 88-cyusb.rules: the observable
# behaviour was right for the wrong reason. See defect D23, and the identical note in
# fx3/programmer/configs/70-domesday-duplicator.rules. Anything below 73 is fine.
#
# Installed on NixOS by nix/modules/udev.nix when hardware.domesdayDuplicator.enable and
# .usbBlaster are set. Elsewhere, copy it to /etc/udev/rules.d/ and run
# `udevadm control --reload && udevadm trigger`.

# USB-Blaster. 6001 is the original, and is what the DE0-NANO has on board; 6002 and 6003
# are the later revisions Altera shipped under the same driver.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="09fb", ATTR{idProduct}=="6001", MODE="0666", TAG+="uaccess", TAG+="usb_blaster"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="09fb", ATTR{idProduct}=="6002", MODE="0666", TAG+="uaccess", TAG+="usb_blaster"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="09fb", ATTR{idProduct}=="6003", MODE="0666", TAG+="uaccess", TAG+="usb_blaster"

# USB-Blaster II. Not used by the DE0-NANO, but a standalone cable is the usual way to
# program a board with no on-board blaster, and leaving it out is a confusing failure for
# anyone who has one.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="09fb", ATTR{idProduct}=="6010", MODE="0666", TAG+="uaccess", TAG+="usb_blaster"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="09fb", ATTR{idProduct}=="6810", MODE="0666", TAG+="uaccess", TAG+="usb_blaster"
