# Device permissions for the Domesday Duplicator: the Cypress FX3 it is built around, and the
# Altera USB-Blaster that programs its FPGA.
#
# This is the whole ruleset. Install it and every device the project ever asks you to plug in
# is reachable without root — including the ones that only appear when something has gone
# wrong. Splitting the USB-Blaster off into a file a capture-only install has no reason to
# fetch would mean recovering a board over JTAG began with diagnosing a permissions failure,
# and two files matching the same device are much harder to debug than one.
#
# Originally from Cypress Semiconductor / ATR-LABS (rules by V. Radhakrishnan, rk@atr-labs.com),
# rewritten for this project. Two changes from the Cypress original:
#
#   1. The Domesday Duplicator's own VID:PID is matched. Once the FX3 has been programmed it
#      re-enumerates as 1209:2347 and stops being a Cypress device, so the vendor rule alone
#      left the running device root-only and the capture GUI could not open it.
#
#   2. The RUN+= hooks calling /usr/local/bin/cy_renumerate.sh are gone. That script signals
#      a `cyusb` daemon which is part of the full cyusb_linux suite and is not in this
#      project; the path was never installed, so the hook only ever produced udev errors.
#
# TAG+="uaccess" grants access to the user at the active seat on any systemd-logind system,
# including NixOS. MODE is kept at 0666 to preserve the behaviour of the Cypress original on
# systems without logind; tighten it to 0660 if uaccess covers all of your users.
#
# THE FILENAME IS LOAD-BEARING. udev processes rule files in lexical order, and systemd
# consumes the uaccess tag in 73-seat-late.rules:
#
#     TAG=="uaccess", ENV{MAJOR}!="", RUN{builtin}+="uaccess"
#
# A rule that sets the tag in a file sorting after 73 sets it too late: 73 has already run,
# nothing consumes it, and no ACL is applied. This file was called 88-cyusb.rules until
# exactly that was found on a live device — the rule was installed and active,
# and `getfacl` on the device node showed no user entry. Only the MODE="0666" fallback was
# doing any work. Anything below 73 is fine; 70- matches the convention systemd itself uses
# for its own uaccess rules.
#
# MODE is not affected by ordering — udev accumulates it across all matching rules and
# applies it when the node is created — which is why the bug stayed invisible.

# Cypress FX3 in bootloader mode — this is what fx3-programmer talks to.
# 04b4:00f3 is the FX3 bootloader; the wildcard covers the other Cypress bootloader PIDs
# (00f0, 0080 and friends) that a partially programmed device can present.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="04b4", MODE="0666", TAG+="uaccess", TAG+="cyusb_dev"

# The SuperSpeed Explorer Kit's on-board USB-UART bridge, 04b4:0007. The kit exposes the FX3's
# debug console over it, so this is where firmware printf output comes out. The vendor rule
# above already covers the usb_device node; a serial port is only usable through the tty node,
# and that node matches neither SUBSYSTEM=="usb" nor ENV{DEVTYPE}=="usb_device", so it needs
# its own rule. ATTRS (plural) walks up to the parent USB device, because the tty device itself
# carries no idVendor/idProduct of its own.
#
# The bridge presents a CDC-ACM interface and binds to the cdc_acm driver, so the node is
# /dev/ttyACM<n> — not ttyUSB, which is where the other USB serial adaptors on a typical bench
# land. Matching on SUBSYSTEM=="tty" covers either, so the rule does not depend on which.
SUBSYSTEM=="tty", ATTRS{idVendor}=="04b4", ATTRS{idProduct}=="0007", MODE="0666", TAG+="uaccess", TAG+="cyusb_dev"

# Domesday Duplicator in application mode — this is what the capture GUI opens.
# 1209:2347 is registered to this project with pid.codes (https://pid.codes/1209/2347/). It
# replaces 1d50:603b, an OpenMoko-range ID this project never held an allocation for — usb.ids
# lists it as someone else's device. Boards running earlier firmware still enumerate as
# 1d50:603b and are not matched here; reprogram them.
# The VID/PID pair is set in fx3/firmware/src/usb-descriptor.c and in
# ddd-gui/src/capture/wire_protocol.h; all three must agree.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1209", ATTR{idProduct}=="2347", MODE="0666", TAG+="uaccess", TAG+="ddd_dev"

# ---------------------------------------------------------------------------------------
# Altera USB-Blaster — the JTAG cable that programs the FPGA.
#
# The DE0-NANO carries an on-board USB-Blaster, so on that board this is not an extra cable
# to buy: it enumerates as 09fb:6001 on the same USB connector used to power the board.
#
# Neither Altera's own installer nor nixpkgs' quartus-prime-lite ships any udev rules
# (checked), so without these lines the device node is root-only and both of the tools that
# touch JTAG fail the same way:
#
#     $ jtagconfig
#     1) USB-Blaster variant [7-3.2]
#       Unable to lock chain - Insufficient port permissions
#
# These rules are here rather than in an FPGA-only file because JTAG is the recovery path.
# A machine that has only ever captured is exactly the machine that needs the cable to work
# first time, on the day the gateware has to be rewritten.
# ---------------------------------------------------------------------------------------

# USB-Blaster. 6001 is the original, and is what the DE0-NANO has on board; 6002 and 6003
# are the later revisions Altera shipped under the same driver.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="09fb", ATTR{idProduct}=="6001", MODE="0666", TAG+="uaccess", TAG+="usb_blaster"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="09fb", ATTR{idProduct}=="6002", MODE="0666", TAG+="uaccess", TAG+="usb_blaster"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="09fb", ATTR{idProduct}=="6003", MODE="0666", TAG+="uaccess", TAG+="usb_blaster"

# USB-Blaster II. Not used by the DE0-NANO, but a standalone cable is the usual way to
# program a board with no on-board blaster, and leaving it out is a confusing failure for
# anyone who has one.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="09fb", ATTR{idProduct}=="6010", MODE="0666", TAG+="uaccess", TAG+="usb_blaster"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="09fb", ATTR{idProduct}=="6810", MODE="0666", TAG+="uaccess", TAG+="usb_blaster"
